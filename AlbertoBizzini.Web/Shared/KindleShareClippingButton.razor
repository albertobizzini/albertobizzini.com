@using System.Text
@using KindleClippings
@inject IStringLocalizer<SharedResources> SR
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

@if (!string.IsNullOrWhiteSpace(Clipping?.Text))
{
    <ShareButton Title="@GetTitleAndAuthor()"
                 Text="@GetFullQuote(shorten: true)"
                 Url="@ShareUrl"
                 Color="Color.Primary"
                 Size="@Size" />

	<MudTooltip Text="@SR["CopyToClipboardTooltip"]">
        <MudIconButton Icon="@Icons.Material.Outlined.CopyAll" Size="@Size" Color="Color.Primary" OnClick="CopyAsync" />
    </MudTooltip>
}


@code {
    [Parameter] public Clipping? Clipping { get; set; } = null;
    [Parameter] public bool UseWebShareApi { get; set; } = false;
    [Parameter] public Size Size { get; set; } = Size.Small;

    private string? ShareUrl => Clipping is not null
        ? $"{NavigationManager.BaseUri}clipping/{Clipping.Id}"
        : null;

    private string? GetTitleAndAuthor()
    {
        var sb = new StringBuilder();
        string delim = string.Empty;
        if (!string.IsNullOrWhiteSpace(Clipping?.Book?.Title))
        {
            sb.Append($"{delim}\"{Clipping.Book.Title}\"");
            delim = " - ";
        }
        if (!string.IsNullOrWhiteSpace(Clipping?.Book.Author))
        {
            sb.Append($"{delim}{Clipping.Book.Author}");
            delim = " - ";
        }

        return sb.ToString();
    }

    private string GetFullQuote(bool shorten)
    {
        if (string.IsNullOrWhiteSpace(Clipping?.Text))
            return string.Empty;

        var quote = Clipping.QuotedText!.ToString();
        const int MaxLength = 200;
        if (shorten && quote.Length > MaxLength)
            quote = quote.Remove(MaxLength) + "…";

        var suffix = GetTitleAndAuthor();
        if (!string.IsNullOrWhiteSpace(suffix))
            quote += $"\n({suffix})";

        quote += $"\n{ShareUrl}";

        return quote;
    }

    public async Task CopyAsync()
    {
        var quote = GetFullQuote(shorten: false);
        await JS.InvokeVoidAsync("copyToClipboard", quote);
        Snackbar.Add(SR["CopiedToClipbboardFeedbackMessage"], Severity.Success);
    }
}
