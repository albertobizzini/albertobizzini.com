@page "/clippings"
@using AlbertoBizzini.Web.Shared
@using KindleClippings
@inject IStringLocalizer<SharedResources> SR
@inject IStringLocalizer<BrowseClippings> L
@inject KindleClippingService KindleService
@inject ILogger<BrowseClippings> Logger

<MudBreakpointProvider OnBreakpointChanged="BreakpointChanged" />

<PageHeader L="@L" />

@if (!_loading && _clippings?.Count > 0)
{
    <MudPaper Elevation="6" class="pa-2 pb-4">
        <h3 class="mb-4">@L["FiltersAndSortingHeaderText"]</h3>


        <MudStack Row Wrap="Wrap.Wrap"
                  AlignItems="AlignItems.Stretch"
                  Justify="Justify.FlexStart"
                  Spacing="3"
                  Class="px-2">

            <MudTextField @bind-Value="_boundSearchString"
                          Label="@L["SearchLabel", MinSearchKeywordLength]"
                          Immediate="true"
                          DebounceInterval="400"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable
                          Variant="Variant.Text"
                          IconSize="Size.Medium" />

            <MudSelect T="string"
                       Value="@_selectedAuthor"
                       ValueChanged="OnAuthorChanged"
                       Label="@L["BookAuthorLabel"]"
                       ShrinkLabel="false"
                       Dense
                       Clearable
                       HelperText="@HowToSelectedAnotherAuthorHelperText">

                @if (_filteredAuthors.Count > 0)
                {
                    @foreach (var author in _filteredAuthors)
                    {
                        <MudSelectItem Value="author">
                            @author
                        </MudSelectItem>
                    }
                }

            </MudSelect>

            @if (!string.IsNullOrWhiteSpace(_selectedAuthor) &&
                 _filteredAuthorTitles.Count > 0)
            {
                <MudSelect T="string"
                           @bind-Value="_selectedTitle"
                           Label="@L["BookTitleLabel"]"
                           ShrinkLabel="false"
                           Dense
                           Clearable>

                    @foreach (var title in _filteredAuthorTitles)
                    {
                        <MudSelectItem Value="title">
                            @title
                        </MudSelectItem>
                    }

                </MudSelect>
            }

        </MudStack>

        <MudStack Row
                  Wrap="Wrap.Wrap"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.FlexStart"
                  Spacing="2"
                  Class="mt-6 px-2">

            <MudSelect T="SortOption"
                       Value="@_sortBy"
                       ValueChanged="SortByChanged"
                       Label="@L["SortByLabel"]"
                       Dense
                       Variant="Variant.Filled"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.TwoTone.Sort"
                       FitContent
                       Style="width: 12rem">

                <MudSelectItem Value="SortOption.AddedOn">
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween">
                        @L["AddedOnLabel"]
                        <MudIcon Size="Size.Small"
                                 Icon="@GetIcon(SortOption.AddedOn)" />
                    </MudStack>
                </MudSelectItem>

                <MudSelectItem Value="SortOption.Author">
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween">
                        @L["BookAuthorLabel"]
                        <MudIcon Size="Size.Small"
                                 Icon="@GetIcon(SortOption.Author)" />
                    </MudStack>
                </MudSelectItem>

                <MudSelectItem Value="SortOption.Title">
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween">
                        @L["BookTitleLabel"]
                        <MudIcon Size="Size.Small"
                                 Icon="@GetIcon(SortOption.Title)" />
                    </MudStack>
                </MudSelectItem>

            </MudSelect>

            <MudSwitch T="bool"
                       Value="@_descending"
                       ValueChanged="DescendingChanged"
                       Size="Size.Small"
                       Color="Color.Primary"
                       UncheckedColor="Color.Inherit">
                @L["DescendingLabel"]
            </MudSwitch>

        </MudStack>

    </MudPaper>

}

<div class="mt-4 mb-2 textalign-center">
    <MudText Typo="Typo.caption"
             Class="opacity-lo"
             Align="Align.Center">
        @L.FormatWithMarkup(
            "ShowClippingsCount",
            _filteredAndSortedClippings.Count.ToString("n0"))
    </MudText>
</div>

@if (IsMobile)
{
    <MudTable T="Clipping"
              Items="_filteredAndSortedClippings"
              Loading="_loading"
              Bordered="false"
              Dense="false"
              Outlined="false"
              Breakpoint="Breakpoint.None">

        <NoRecordsContent>
            @SR["NoKindleClippingIsAvailableWarningMessage"]
        </NoRecordsContent>

        <RowTemplate>
            <MudTd>
                <KindleClippingDisplay Clipping="@context"
                                       HighlightedTexts="@_searchkeywords" />
            </MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager />
        </PagerContent>

    </MudTable>

}
else
{

    <MudDataGrid T="Clipping"
                 Items="_filteredAndSortedClippings"
                 Loading="_loading"
                 Filterable="true"
                 MultiSelection="false"
                 Breakpoint="Breakpoint.None"
                 Outlined
                 SortMode="SortMode.None">

        <ToolBarContent>
        </ToolBarContent>

        <NoRecordsContent>
            @SR["NoKindleClippingIsAvailableWarningMessage"]
        </NoRecordsContent>

        <Columns>

            <TemplateColumn>
                <HeaderTemplate>
                    @L["ClippedTextLabel"]
                </HeaderTemplate>

                <CellTemplate>
                    <KindleClippingDisplay Clipping="@context.Item"
                                           HighlightedTexts="@_searchkeywords"
                                           JustTheQuote />
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>
                    @L["BookAuthorLabel"]
                </HeaderTemplate>

                <CellTemplate>
                    <MudHighlighter Text="@context.Item.Book.Author"
                                    HighlightedTexts="@_searchkeywords" />
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>
                    @L["BookTitleLabel"]
                </HeaderTemplate>

                <CellTemplate>
                    <MudHighlighter Text="@context.Item.Book.Title"
                                    HighlightedTexts="@_searchkeywords" />
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.AddedOn"
                            Title="@L["AddedOnLabel"]"
                            Format="d" />

        </Columns>

        <PagerContent>
            <MudDataGridPager T="Clipping" />
        </PagerContent>

    </MudDataGrid>

}

@code
{
    private bool _loading = true;

    private List<Clipping> _clippings = [];
    private List<SearchableClipping> _searchableClippings = [];

    private List<Clipping> _filteredAndSortedClippings = [];
    private List<string> _filteredAuthors = [];
    private List<string> _filteredAuthorTitles = [];

    private const int MinSearchKeywordLength = 3;

    private string _searchString = string.Empty;
    private List<string> _searchkeywords = [];

    private string? _selectedAuthor;
    private string? _selectedTitle;

    private SortOption _sortBy = SortOption.AddedOn;
    private bool _descending = true;

    private enum SortOption
    {
        AddedOn,
        Author,
        Title
    }

    private sealed record SearchableClipping(
        Clipping Clipping,
        string SearchText);


    private string _boundSearchString
    {
        get => _searchString;

        set
        {
            if (string.Equals(_searchString, value, StringComparison.Ordinal))
                return;

            _searchString = value;

            _searchkeywords = value
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries |
                    StringSplitOptions.TrimEntries)
                .Where(x => x.Length >= MinSearchKeywordLength)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            ApplyFilters();
        }
    }


    private string? HowToSelectedAnotherAuthorHelperText =>
        string.IsNullOrWhiteSpace(_selectedAuthor)
            ? null
            : L["HowToSelectedAnotherAuthorHelperText"];


    protected override async Task OnInitializedAsync()
    {
        var result = await KindleService.LoadAsync();

        _clippings = result.Clippings ?? [];

        // Prepara una sola volta il testo utilizzato
        // per la ricerca full-text.
        _searchableClippings = _clippings
            .Select(c => new SearchableClipping(
                c,
                BuildSearchText(c)))
            .ToList();

        _loading = false;

        ApplyFilters();
    }


    private static string BuildSearchText(Clipping clipping)
    {
        return string.Join(
            ' ',
            clipping.Book.Author,
            clipping.Book.Title,
            clipping.QuotedText);
    }

    private void SortByChanged(SortOption newSortBy)
    {
        if (_sortBy == newSortBy) return;

        _sortBy = newSortBy;
        ApplyFilters();
    }


    private void DescendingChanged(bool newDescending)
    {
        if (_descending == newDescending) return;

        _descending = newDescending;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        IEnumerable<SearchableClipping> result =
            _searchableClippings;

        // Filtro autore
        if (!string.IsNullOrWhiteSpace(_selectedAuthor))
        {
            result = result.Where(x =>
                string.Equals(
                    x.Clipping.Book.Author,
                    _selectedAuthor,
                    StringComparison.OrdinalIgnoreCase));
        }

        // Filtro titolo
        if (!string.IsNullOrWhiteSpace(_selectedTitle))
        {
            result = result.Where(x =>
                string.Equals(
                    x.Clipping.Book.Title,
                    _selectedTitle,
                    StringComparison.OrdinalIgnoreCase));
        }

        // Ricerca libera.
        // Tutte le parole chiave devono essere presenti.
        if (_searchkeywords.Count > 0)
        {
            result = result.Where(MatchesSearch);
        }

        // Materializza i risultati una sola volta.
        var filtered = result
            .Select(x => x.Clipping)
            .ToList();

        // Ordinamento
        _filteredAndSortedClippings = ApplySorting(filtered);

        // Aggiorna lista autori
        _filteredAuthors = _filteredAndSortedClippings
            .Where(c => !string.IsNullOrWhiteSpace(c.Book.Author))
            .Select(c => c.Book.Author!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(a => a)
            .ToList();

        // Aggiorna lista titoli dell'autore selezionato
        _filteredAuthorTitles = string.IsNullOrWhiteSpace(_selectedAuthor)
            ? []
            : _filteredAndSortedClippings
                .Where(c =>
                    string.Equals(
                        c.Book.Author,
                        _selectedAuthor,
                        StringComparison.OrdinalIgnoreCase))
                .Select(c => c.Book.Title)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(t => t)
                .ToList();
    }


    private bool MatchesSearch(SearchableClipping item)
    {
        // AND:
        // tutte le keyword devono essere presenti
        foreach (var keyword in _searchkeywords)
        {
            if (!item.SearchText.Contains(
                    keyword,
                    StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
        }

        return true;
    }


    private List<Clipping> ApplySorting(List<Clipping> clippings)
    {
        if (_descending)
        {
            return _sortBy switch
            {
                SortOption.Author =>
                    clippings
                        .OrderByDescending(c => c.Book.Author)
                        .ToList(),

                SortOption.Title =>
                    clippings
                        .OrderByDescending(c => c.Book.Title)
                        .ToList(),

                _ =>
                    clippings
                        .OrderByDescending(c => c.AddedOn)
                        .ToList()
            };
        }

        return _sortBy switch
        {
            SortOption.Author =>
                clippings
                    .OrderBy(c => c.Book.Author)
                    .ToList(),

            SortOption.Title =>
                clippings
                    .OrderBy(c => c.Book.Title)
                    .ToList(),

            _ =>
                clippings
                    .OrderBy(c => c.AddedOn)
                    .ToList()
        };
    }


    private void OnAuthorChanged(string? author)
    {
        if (string.Equals(
                _selectedAuthor,
                author,
                StringComparison.Ordinal))
        {
            return;
        }

        _selectedAuthor = author;

        // Il titolo precedente non è più necessariamente valido
        // per il nuovo autore.
        _selectedTitle = null;

        ApplyFilters();
    }


    private string? GetIcon(SortOption sortOption) => sortOption switch
    {
        SortOption.Author =>
            Icons.Material.TwoTone.PersonSearch,

        SortOption.Title =>
            Icons.Material.TwoTone.MenuBook,

        SortOption.AddedOn =>
            Icons.Material.TwoTone.CalendarMonth,

        _ => null
    };


    #region Breakpoint

    private Breakpoint _breakpoint;

    private Task BreakpointChanged(Breakpoint breakpoint)
    {
        _breakpoint = breakpoint;
        return Task.CompletedTask;
    }

    private bool IsMobile =>
        _breakpoint <= Breakpoint.Sm;

    #endregion

}
