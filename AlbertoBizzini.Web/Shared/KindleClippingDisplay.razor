@using KindleClippings
@inject NavigationManager Nav
@inject IStringLocalizer<KindleClippingDisplay> L

@if (JustTheQuote)
{
    @if (Clipping is null)
    {
        <MudSkeleton />
    }
    else
    {
        <MudStack Row Justify="Justify.FlexStart" AlignItems="AlignItems.Center" StretchItems="StretchItems.Start" Spacing="1">
            <MudText HtmlTag="@HtmlTag" Color="@Color"><MudHighlighter Text="@Clipping.QuotedText" HighlightedTexts="@HighlightedTexts" /></MudText>

            @if (!HideShareButton)
            {
                <KindleShareClippingButton Clipping="Clipping" />
            }
        </MudStack>
    }
}
else
{
    <MudStack Row Justify="Justify.FlexStart" AlignItems="AlignItems.Center" StretchItems="StretchItems.Start">

        <MudStack>
            <MudPaper Elevation="8" Class="pa-3">
                @if (Clipping is null)
                {
                    <MudSkeleton />
                    <MudSkeleton />
                }
                else
                {
                    <MudText HtmlTag="@HtmlTag" Color="@Color"><MudHighlighter Text="@Clipping.QuotedText" HighlightedTexts="@HighlightedTexts" /></MudText>
                }
            </MudPaper>
            @if (Clipping is not null)
            {
                <MudStack Row Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">

                    <MudText Typo="Typo.caption" Align="Align.Right" Class="mt-3" Style="display:block">
                        @L["ExtractedFromLabel"]
                        <MudLink Href="@KindleClippingService.BrowseAuthorClippingsHref(Clipping.Id, toTitle: true)" StartIcon="@Icons.Material.TwoTone.Link">
                            <MudHighlighter Text="@Clipping.Book.Title" HighlightedTexts="@HighlightedTexts" />
                        </MudLink>
                        @if (Clipping.Book.Author is not null)  
                        {
                            <span class="ml-2">(<MudLink Href="@KindleClippingService.BrowseAuthorClippingsHref(Clipping.Id, toTitle: false)" StartIcon="@Icons.Material.TwoTone.Link"><MudHighlighter Text="@Clipping.Book.Author" HighlightedTexts="@HighlightedTexts" /></MudLink>)</span>
                        }
                        @if (Clipping.AddedOn is not null)
                        {
                            <MudText Typo="Typo.caption" Class="opacity-med" Style="display:block">(@L["AddedOnLabel"] @Clipping.AddedOn.Value.ToShortDateString() - @L["PositionLabel"]: @Clipping.StartLocation)</MudText>
                        }
                    </MudText>


                </MudStack>

            }
        </MudStack>

    </MudStack>

    @if (!HideShareButton)
    {
        <MudStack Row Justify="Justify.Center" Class="mt-2">
            <KindleShareClippingButton Clipping="Clipping" Size="Size.Medium" />
        </MudStack>
    }

}

@code {
    [Parameter] public Clipping Clipping { get; set; }
    [Parameter] public bool JustTheQuote { get; set; } = false;
    [Parameter] public bool HideShareButton { get; set; } = false;
    [Parameter] public IEnumerable<string> HighlightedTexts { get; set; }
    [Parameter] public string HtmlTag { get; set; } = "em";
    [Parameter] public Color Color { get; set; } = Color.Info;
}