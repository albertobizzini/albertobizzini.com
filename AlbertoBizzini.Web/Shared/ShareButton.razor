@using Microsoft.JSInterop
@using MudBlazor

@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResources> SR

@if (Url is not null)
{
    <MudTooltip Text="@_tooltip">
        <MudIconButton Icon="@Icon"
                       Color="@Color"
                       Size="@Size"
                       Variant="@Variant"
                       Disabled="@_isSharing"
                       OnClick="ShareAsync"
                       AriaLabel="@Tooltip" />
    </MudTooltip>
}

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string? Url { get; set; }

    [Parameter]
    public string Tooltip { get; set; }

    [Parameter]
    public string CopiedMessage { get; set; }

    [Parameter]
    public string ShareErrorMessage { get; set; }

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.Share;

    [Parameter]
    public Color Color { get; set; } = Color.Default;

    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    [Parameter]
    public Variant Variant { get; set; } = Variant.Text;

    [Parameter]
    public EventCallback OnShared { get; set; }

    private bool _isSharing;

    private string? _tooltip => $"{Tooltip}…";

    protected override async Task OnInitializedAsync()
    {
        Tooltip ??= SR["ShareButtonTooltip"];
        CopiedMessage ??= SR["ShareButtonCopiedMessage"];
        ShareErrorMessage ??= SR["ShareButtonShareErrorMessage"];
    }

    private async Task ShareAsync()
    {
        if (_isSharing)
            return;

        _isSharing = true;

        try
        {
            var result = await JS.InvokeAsync<ShareResult>(
                "shareButton.share",
                new
                {
                    title = Title,
                    text = Text,
                    url = Url
                });

            if (result.Shared)
            {
                await OnShared.InvokeAsync();
            }
            else if (result.Copied)
            {
                Snackbar.Add(
                    CopiedMessage,
                    Severity.Success);

                await OnShared.InvokeAsync();
            }
            else if (!result.Cancelled)
            {
                Snackbar.Add(
                    ShareErrorMessage,
                    Severity.Error);
            }
        }
        catch (JSException)
        {
            Snackbar.Add(
                ShareErrorMessage,
                Severity.Error);
        }
        finally
        {
            _isSharing = false;
        }
    }

    private sealed class ShareResult
    {
        public bool Shared { get; set; }

        public bool Copied { get; set; }

        public bool Cancelled { get; set; }
    }
}