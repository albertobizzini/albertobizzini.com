@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudCarousel TData="string"
                     Class="image-carousel"
                     AutoCycle="@AutoCycle"
                     AutoCycleTime="@CycleTime"
                     ShowArrows="true"
                     ShowBullets="true"
                     EnableSwipeGesture="true">

            @foreach (var url in ImageUrls)
            {
                <MudCarouselItem TData="string">
                    <div class="image-container">
                        <img src="@url" alt="Immagine slideshow" />
                    </div>
                </MudCarouselItem>
            }
        </MudCarousel>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close">Chiudi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public List<string> ImageUrls { get; set; } = new();

    [Parameter]
    public bool AutoCycle { get; set; } = false;

    [Parameter]
    public TimeSpan CycleTime { get; set; } =
        TimeSpan.FromSeconds(4);

    private void Close() => MudDialog.Close();
}

<style>
    .image-carousel {
        height: 500px;
    }

    .image-container {
        width: 100%;
        height: 500px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #111;
    }

        .image-container img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }
</style>
